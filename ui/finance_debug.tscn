[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://ui/finance_debug.gd" id="1_script"]
[ext_resource type="Script" path="res://core/systems/demand_system.gd" id="2_demand"]

[node name="FinanceDebug" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="DemandSystem" type="Node" parent="."]
script = ExtResource("2_demand")

[node name="MarginContainer" type="MarginContainer" parent="."]
